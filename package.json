{
  "name": "novo-sol",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run qa:ci",
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "qa:ci": "npm run build && npm run build:single && npm run qa:controls && npm run qa:state && npm run qa:bloom && npm run qa:time && npm run qa:events && npm run qa:subtle && npm run qa:parity",
    "qa:controls": "node tools/qa-controls.js dist-single/index.html",
    "qa:state": "node tools/qa-control-state.js dist-single/index.html",
    "qa:bloom": "node tools/qa-bloom.js dist-single/index.html",
    "qa:time": "node tools/qa-time-controls.js dist-single/index.html",
    "qa:events": "node tools/qa-event-controls.js dist-single/index.html",
    "qa:subtle": "node tools/qa-subtle-controls.js dist-single/index.html qa-subtle",
    "qa:parity": "node tools/parity.js qa-out --file dist-single/index.html && node tools/imgdiff.js qa/baselines qa-out --max-frac 0.001",
    "qa:colorpatch": "node tools/qa-colorpatch.js dist-single/index.html",
    "qa:shot": "node tools/shot.js shots --file dist-single/index.html",
    "qa:phase1": "node tools/qa-phase1.js out/phase1 --file dist-single/index.html",
    "qa:phase3": "node tools/qa-phase3.js out/phase3 --file dist-single/index.html",
    "qa:phase4": "node tools/qa-phase4.js out/phase4 --file dist-single/index.html",
    "qa:phase5": "node tools/qa-phase5.js out/phase5 --file dist-single/index.html",
    "qa:phase6": "node tools/qa-phase6.js out/phase6 --file dist-single/index.html",
    "qa:motion2": "node tools/qa-motion2.js out/motion2 --file dist-single/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgferre/Novo-Sol-Fable-3d.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fgferre/Novo-Sol-Fable-3d/issues"
  },
  "homepage": "https://github.com/fgferre/Novo-Sol-Fable-3d#readme",
  "private": "true",
  "devDependencies": {
    "pixelmatch": "^5.3.0",
    "playwright": "1.56.0",
    "pngjs": "^7.0.0",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
